{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "ExpressJS Server",
  "ts-node": {
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext"
    }
  },
  "compilerOptions": {
    "target": "ES2022",
    "verbatimModuleSyntax": false,
    "module": "esnext",
    "sourceMap": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "removeComments": true,
    "strict": true, 
    "skipLibCheck": true, 
    
  }
}